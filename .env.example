# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clipper?schema=public"

# --- Auth.js -----------------------------------------------------------------
# Générer avec : npx auth secret   (ou : openssl rand -base64 33)
AUTH_SECRET=""
# Client OAuth Google (type "Application Web")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Emails autorisés à se connecter, séparés par des virgules
ALLOWED_EMAILS="moi@example.com"

# --- Gemini (jalon 3) ----------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL=""

# --- Stockage des fichiers (sources, clips, miniatures) -----------------------
STORAGE_DIR="./storage"

# --- Outils vidéo (optionnel) --------------------------------------------------
# Chemins des binaires si ceux du PATH ne conviennent pas (ex. Windows avec plusieurs ffmpeg)
# FFMPEG_PATH="C:/ProgramData/chocolatey/bin/ffmpeg.exe"
# FFPROBE_PATH="ffprobe"
# YTDLP_PATH="yt-dlp"
# Fichier cookies.txt (format Netscape) d'une session YouTube connectée, pour les vidéos
# privées ou si YouTube bloque le serveur (« confirme que tu n'es pas un robot »)
# YTDLP_COOKIES="/chemin/vers/cookies.txt"
