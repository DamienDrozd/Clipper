# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clipper?schema=public"

# --- Auth.js -----------------------------------------------------------------
# Générer avec : npx auth secret   (ou : openssl rand -base64 33)
AUTH_SECRET=""
# Client OAuth Google (type "Application Web")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Emails autorisés à se connecter, séparés par des virgules
ALLOWED_EMAILS="moi@example.com"

# --- Gemini --------------------------------------------------------------------
GEMINI_API_KEY=""
# Modèles dans l'ordre d'essai, séparés par des virgules : le premier est le principal, les
# suivants servent de secours s'il est surchargé (503) ou limité (429). Ex. : "modele-a,modele-b"
# (l'ancienne variable GEMINI_MODEL, un seul modèle, reste acceptée si GEMINI_MODELS est vide).
GEMINI_MODELS=""

# Réglages optionnels de la couche d'appel (valeurs par défaut indiquées)
# Retries courts par modèle, backoff exponentiel avec jitter : min(max, base × 2^n)
# GEMINI_MAX_RETRIES=3
# GEMINI_BACKOFF_BASE_MS=2000
# GEMINI_BACKOFF_MAX_MS=30000
# Délai max d'un appel (les transcriptions sont longues)
# GEMINI_TIMEOUT_MS=120000
# Coupe-circuit : après N surcharges consécutives, modèle écarté pendant le cooldown
# GEMINI_BREAKER_THRESHOLD=3
# GEMINI_BREAKER_COOLDOWN_MS=300000

# --- Stockage des fichiers (sources, clips, miniatures) -----------------------
STORAGE_DIR="./storage"

# --- Outils vidéo (optionnel) --------------------------------------------------
# Chemins des binaires si ceux du PATH ne conviennent pas (ex. Windows avec plusieurs ffmpeg)
# FFMPEG_PATH="C:/ProgramData/chocolatey/bin/ffmpeg.exe"
# FFPROBE_PATH="ffprobe"
# YTDLP_PATH="yt-dlp"
# Fichier cookies.txt (format Netscape) d'une session YouTube connectée, pour les vidéos
# privées ou si YouTube bloque le serveur (« confirme que tu n'es pas un robot »)
# YTDLP_COOKIES="/chemin/vers/cookies.txt"
