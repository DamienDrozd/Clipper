generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (schéma attendu par @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  videos        Video[]
  settings      ChannelSettings?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Clipper
// ---------------------------------------------------------------------------

enum VideoStatus {
  PENDING
  FETCHING_TRANSCRIPT
  ANALYZING
  DOWNLOADING
  RENDERING
  /// Échec temporaire (Gemini surchargé, réseau…) : pg-boss replanifie le job
  WAITING_RETRY
  DONE
  FAILED
}

enum CaptionKind {
  MANUAL
  ASR
}

enum CropMode {
  CENTER
  BLUR
}

enum RenderStatus {
  PENDING
  QUEUED
  RENDERING
  DONE
  FAILED
}

/// Génération des textes de publication (titre, description, tags) d'un clip
enum TextsStatus {
  IDLE
  PENDING
  FAILED
}

model Video {
  id            String      @id @default(cuid())
  youtubeId     String      @unique
  userId        String
  title         String
  durationSec   Int
  channelId     String
  channelTitle  String
  thumbnailUrl  String?
  status        VideoStatus @default(PENDING)
  /// Progression de l'étape en cours (téléchargement, rendu), 0-100
  progress      Int         @default(0)
  error         String?
  /// Options choisies à la soumission : { clipCount, minDuration, maxDuration, language, cropMode }
  options       Json
  /// Chemin du MP4 source téléchargé par yt-dlp (relatif à STORAGE_DIR)
  sourcePath    String?
  /// Modèle Gemini qui a réellement produit la sélection (secours éventuel)
  analysisModel String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript Transcript?
  clips      Clip[]

  @@index([userId, createdAt])
}

model Transcript {
  id             String      @id @default(cuid())
  videoId        String      @unique
  language       String
  kind           CaptionKind
  captionTrackId String
  /// Segments parsés du VTT : [{ start, end, text }] en secondes
  segments       Json
  createdAt      DateTime    @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Clip {
  id                 String       @id @default(cuid())
  videoId            String
  start              Float
  end                Float
  title              String
  hook               String
  score              Int
  reason             String
  cropMode           CropMode     @default(BLUR)
  /// Zone de la source affichée { x, y, w, h } en fractions 0–1 (null = cadrage par défaut)
  crop               Json?
  /// Corrections manuelles des sous-titres : [{ start, end, text }] par segment de la transcription (null = aucune)
  captionOverrides   Json?
  renderStatus       RenderStatus @default(PENDING)
  /// Progression du rendu, 0-100
  renderProgress     Int          @default(0)
  renderError        String?
  /// Chemins relatifs à STORAGE_DIR
  mp4Path            String?
  srtPath            String?
  thumbPath          String?
  renderedAt         DateTime?
  /// Textes de publication YouTube (null = à générer)
  publishTitle       String?
  publishDescription String?
  tags               String[]     @default([])
  textsStatus        TextsStatus  @default(IDLE)
  textsError         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, score])
}

// ---------------------------------------------------------------------------
// Gemini : cache et journal des appels (sans lien vers Video : conservés après suppression)
// ---------------------------------------------------------------------------

/// Réponses Gemini validées. Clé : SHA-256 de l'usage, de la version du prompt, des consignes,
/// du prompt (transcription + options) et du schéma de sortie.
model LlmCache {
  hash      String   @id
  purpose   String
  model     String
  data      Json
  createdAt DateTime @default(now())
}

/// Une ligne par tentative d'appel à Gemini, pour suivre les erreurs par modèle et par heure.
model LlmCallLog {
  id           String   @id @default(cuid())
  videoId      String?
  purpose      String
  model        String
  attempt      Int
  /// SUCCESS, ERROR ou SKIPPED (modèle écarté par le coupe-circuit)
  outcome      String
  errorKind    String?
  httpStatus   Int?
  durationMs   Int
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([model, createdAt])
}

/// Contexte de la chaîne, injecté dans les prompts Gemini (une ligne par utilisateur).
model ChannelSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  channelName        String   @default("")
  /// Description courte de la chaîne et de son public
  channelDescription String   @default("")
  /// Ton souhaité pour les textes de publication
  tone               String   @default("")
  /// Hashtags toujours ajoutés aux descriptions (ex. « #menuiserie #atelier »)
  fixedHashtags      String   @default("")
  /// Ajouter « Vidéo complète : <url> » aux descriptions
  appendSourceLink   Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
